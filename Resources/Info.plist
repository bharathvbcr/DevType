<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- §6.2: declare shipped localizations so macOS does not treat the app as
         English-only. LocalizationManager ships en/ko/ja tables; without this key
         the system language submenu is the only way to switch. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ko</string>
        <string>ja</string>
    </array>
    <key>CFBundleExecutable</key>
    <string>DevType</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.devtype.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>DevType</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- §7.6: these are the SOURCE placeholders. Scripts/package-app.sh overwrites
         both in the packaged bundle from `git describe`, so shipped builds carry a
         real version and DiagnosticReport output can be mapped back to a commit. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.7</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <!-- §7.5: update checking is DevType's own (Sources/ExpanderEngine/Updates/), not Sparkle.
         The former SUFeedURL/SUEnableInstallerLauncherService pair is gone: Sparkle was never
         embedded, so those keys configured a framework that does not exist, and the URL pointed
         at `github.com/bharath/DevType` — an account that is not this project's (`bharathvbcr`).
         UpdateChecker asks the GitHub Releases API directly, only when the user opts in, and
         opens the release page rather than installing anything. -->

    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <!-- DevType's local Whisper and OpenAI-compatible providers use loopback HTTP.
         Declare that narrow ATS intent without disabling ATS for remote traffic. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 DevType. All rights reserved.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>DevType requires Accessibility access to replace trigger keywords with expanded text in active applications.</string>
    <key>NSInputMonitoringUsageDescription</key>
    <string>DevType requires Input Monitoring access to detect trigger keywords as you type.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>DevType requires Microphone access to capture audio for Smart Dictation. Your selected voice engine determines whether audio stays on this Mac or is sent to a cloud service.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>DevType uses Apple Speech Recognition for Apple-based transcription and optional live previews.</string>
</dict>
</plist>
