<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- §6.2: declare shipped localizations so macOS does not treat the app as
         English-only. LocalizationManager ships en/ko/ja tables; without this key
         the system language submenu is the only way to switch. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ko</string>
        <string>ja</string>
    </array>
    <key>CFBundleExecutable</key>
    <string>DevType</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.devtype.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>DevType</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- §7.6: these are the SOURCE placeholders. Scripts/package-app.sh overwrites
         both in the packaged bundle from `git describe`, so shipped builds carry a
         real version and DiagnosticReport output can be mapped back to a commit. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- §7.5: Sparkle appcast. Update the URL when a release host exists; the
         Sparkle framework is not yet embedded, so this is inert until it is. -->
    <key>SUFeedURL</key>
    <string>https://github.com/bharath/DevType/releases/latest/download/appcast.xml</string>
    <key>SUEnableInstallerLauncherService</key>
    <false/>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 DevType. All rights reserved.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>DevType requires Accessibility access to replace trigger keywords with expanded text in active applications.</string>
    <key>NSInputMonitoringUsageDescription</key>
    <string>DevType requires Input Monitoring access to detect trigger keywords as you type.</string>
</dict>
</plist>
